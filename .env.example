# =============================================================================
# BuildHawk Website — environment variables
# =============================================================================
# Copy to `.env.local` for local dev:  cp .env.example .env.local
# In production these are set in Vercel → Project → Settings → Environment Vars.
# NEVER commit real secrets. `.env*` (except this file) is gitignored.
#
# Health check: GET /api/health reports green/yellow/red based on which of
# these are configured. The four CORE vars below are required for the SaaS
# (command-centre) auth + data flow to work; everything else is optional and
# degrades gracefully when unset.
# =============================================================================

# ---------------------------------------------------------------------------
# CORE — required for command-centre (signup / signin / tenant data)
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled URL from the Neon dashboard).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# HMAC secret for signing session cookies. 32+ chars.
# Generate:  openssl rand -hex 32
BH_AUTH_SECRET=""

# Encryption key for integration secrets at rest. 32-byte base64 string.
# Generate:  openssl rand -base64 32
# (Non-base64 input is accepted and stretched via scrypt, but base64 is preferred.)
BH_ENCRYPTION_KEY=""

# Resend API key — sends magic-link auth emails + form notifications.
# Free tier: https://resend.com  (100 emails/day). Without it, auth + forms are disabled.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# AI — chat assistant ("Charlie") + intelligence briefs
# ---------------------------------------------------------------------------

# Anthropic API key for the on-site chat + command-centre intelligence.
ANTHROPIC_API_KEY=""

# Optional model overrides (sensible defaults are baked in).
# BH_AI_MODEL default:               claude-sonnet-4-6
# INTAKE_MODEL / CHARLIE_MODEL def.: claude-sonnet-4-5-20250929
BH_AI_MODEL=""
INTAKE_MODEL=""
# CHARLIE_MODEL=""   # legacy alias for INTAKE_MODEL; leave unset

# ---------------------------------------------------------------------------
# Billing — Stripe (command-centre subscriptions)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""          # sk_test_... for local, sk_live_... in prod
STRIPE_WEBHOOK_SECRET=""      # whsec_... from the Stripe webhook endpoint

# ---------------------------------------------------------------------------
# Email routing (Resend) — where form submissions land + sender identities
# Defaults exist in code; override only to change addresses.
# ---------------------------------------------------------------------------
INTAKE_TO_EMAIL="info@buildhawk.com.au"
INTAKE_FROM_EMAIL="BuildHawk <hello@buildhawk.com.au>"
LEAD_TO_EMAIL="info@buildhawk.com.au"
LEAD_FROM_EMAIL="BuildHawk <hello@buildhawk.com.au>"
WAITLIST_TO_EMAIL="info@buildhawk.com.au"
WAITLIST_FROM_EMAIL="BuildHawk <hello@buildhawk.com.au>"
PEACE_OF_MIND_TO_EMAIL="info@buildhawk.com.au"
PEACE_OF_MIND_FROM_EMAIL="BuildHawk Peace of Mind <hello@buildhawk.com.au>"
BH_AUTH_FROM_EMAIL="BuildHawk <hello@buildhawk.com.au>"
CONNECTOR_REQUEST_TO_EMAIL="info@buildhawk.com.au"
CPC_ACCESS_REQUEST_TO="info@buildhawk.com.au"

# ---------------------------------------------------------------------------
# Vercel Blob storage - file uploads for /peace-of-mind quote review
# ---------------------------------------------------------------------------
# Read/write token from Vercel - Project - Storage - Blob.
# Without this the /api/peace-of-mind/start route returns 503 and the
# tick-and-flick form falls back to a "send by email instead" state.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Peace of Mind - Stripe pay-first activation (optional)
# ---------------------------------------------------------------------------
# Set PEACE_OF_MIND_PRICE_ID to a Stripe one-off Price ID (price_xxx, mode
# payment, AUD) to switch /peace-of-mind from files-first to pay-first.
#
# When set:
#   - The on-page form collects contact details only (no file upload).
#   - Submit redirects to Stripe Checkout.
#   - After payment, /peace-of-mind/success renders the upload form.
#   - /api/peace-of-mind/start requires a verified-paid session_id.
# When unset:
#   - Current files-first flow runs unchanged.
#   - Ops follows up manually for payment.
#
# Requires STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (above) to be set too.
PEACE_OF_MIND_PRICE_ID=""

# ---------------------------------------------------------------------------
# GoHighLevel (GHL) CRM — lead capture + Homes by NH ("HBNH") sub-account
# ---------------------------------------------------------------------------
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_PIPELINE_ID=""
GHL_STAGE_ID=""
GHL_HBNH_API_KEY=""
GHL_HBNH_LOCATION_ID=""
GHL_HBNH_PROJECT_DATA_FIELD_ID=""

# ---------------------------------------------------------------------------
# Auth / access controls (command-centre)
# ---------------------------------------------------------------------------
# Comma-separated emails. When set, ONLY these may sign in.
BH_SIGNIN_ALLOWLIST=""
# Comma-separated emails allowed to manage the GLOBAL article CMS.
# Fail-closed: if unset, article create/edit/delete/publish is disabled for
# everyone (being signed into a tenant is NOT enough).
BH_ADMIN_EMAILS=""
# "true" closes self-serve signup.
BH_DISABLE_SIGNUP=""
# Comma-separated emails authorised for the founding-tenant seed script.
BH_AUTHORIZED_EMAILS=""
# Shared secret guarding the admin diagnostics endpoint.
SETUP_SECRET=""

# ---------------------------------------------------------------------------
# Site URLs (usually auto-derived from Vercel; set for local/preview)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Testing only (used by scripts/*pressure-test*.mjs and e2e)
# ---------------------------------------------------------------------------
# E2E_PASSWORD=""
# ENV_FILE=""
